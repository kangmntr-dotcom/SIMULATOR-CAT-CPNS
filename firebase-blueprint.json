{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "username": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "nik": { "type": "string" },
        "examNumber": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Question": {
      "collection": "questions",
      "fields": {
